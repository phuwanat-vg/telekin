# Normalise line endings in the repository, and keep the files that Linux and
# macOS execute or parse as LF in every checkout — a bash script or a systemd
# unit with CRLF line endings fails in ways that take an afternoon to find.
* text=auto
*.sh            text eol=lf
*.service       text eol=lf
*.desktop       text eol=lf
*.plist         text eol=lf
*.yml           text eol=lf
*.py            text eol=lf
packaging/linux/debian/*  text eol=lf
*.ps1           text eol=crlf
*.iss           text eol=crlf
*.png binary
*.ico binary
